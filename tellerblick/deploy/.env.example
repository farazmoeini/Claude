# Copy to .env on the server and fill in. NEVER commit .env.

# --- Required ---------------------------------------------------------------
DOMAIN=api.tellerblick.de                 # DNS A record must point to the server IP
PUBLIC_URL=https://api.tellerblick.de
SECRET_KEY=REPLACE_ME                     # generate: openssl rand -hex 32
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME       # console.anthropic.com -> API Keys
TELLERBLICK_MODEL=claude-opus-5-5         # cheaper: claude-haiku-5-5 (test quality first)

# --- Subscriptions (RevenueCat) ----------------------------------------------
BILLING_MODE=revenuecat                   # 'off' = everyone premium (testing only!)
REVENUECAT_SECRET_KEY=sk_REPLACE_ME       # RevenueCat -> Project -> API keys -> secret key
REVENUECAT_WEBHOOK_AUTH=REPLACE_ME        # any long random value; same value in the RevenueCat webhook
ENTITLEMENT_ID=premium
FREE_SCANS=3
DAILY_SCAN_LIMIT=40

# --- E-mail for "forgot password" (e.g. Brevo, Postmark, Mailjet) -----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Tellerblick <noreply@tellerblick.de>

CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost
