{
  "name": "zerfallzone",
  "productName": "Zerfallzone",
  "version": "1.0.0",
  "description": "Vertikaler Arena-Battle-Royale: Solo, Duos, Trios – offline gegen Bots oder online mit Freunden",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/server.js",
    "app": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test": "node --test test/*.test.js",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "three": "0.160.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.zerfallzone.game",
    "productName": "Zerfallzone",
    "files": [
      "electron/**",
      "server/**",
      "shared/**",
      "public/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Zerfallzone"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "three-jsm"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/farazmoeini/claude.git"
  }
}
